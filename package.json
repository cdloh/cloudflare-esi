{
  "name": "cloudflare-esi",
  "version": "0.5.1",
  "repository": "cdloh/cloudflare-esi",
  "description": "ESI Parser built to run in Cloudflare workers",
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write '*.{json,js,ts}' 'src/**/*.{js,ts}' 'test/**/*.{js,ts}'",
    "lint": "eslint --max-warnings=0 src && prettier --check '*.{json,js,ts}' 'src/**/*.{js,ts}' 'test/**/*.{js,ts}'",
    "prepack": "npm run-script test && npm run-script lint && npm run-script build",
    "pretty": "prettier --check '*.{json,js,ts}' 'src/**/*.{js,ts}' 'test/**/*.{js,ts}'",
    "semantic-release": "semantic-release"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/github",
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "package-lock.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  },
  "keywords": [
    "serviceworker",
    "cloudflare",
    "workers",
    "esi",
    "esi-parser"
  ],
  "author": {
    "name": "Callum Loh",
    "email": "callumloh@gmail.com"
  },
  "files": [
    "dist"
  ],
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@eslint/js": "^10.0.1",
    "@msw/cloudflare": "^0.2.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-istanbul": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.2",
    "globals": "^17.14.0",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "dependencies": {
    "worktop": "0.7.3"
  }
}
